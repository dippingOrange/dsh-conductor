{
  "name": "@dippingorange/dsh-conductor",
  "version": "2.0.0",
  "description": "Route implementation work from the main model to executor models and collect their reports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dippingOrange/dsh-conductor.git",
    "directory": "dsh-conductor"
  },
  "homepage": "https://github.com/dippingOrange/dsh-conductor#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-model",
    "orchestration",
    "subagent"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./preset": "./preset.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "preset.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
